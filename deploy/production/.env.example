# Server-only secrets. This file is read by Docker Compose, not sourced by a shell.
# init-env.sh generates the first three values once; keep them across restarts.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SESSION_ENCRYPTION_KEY=

# Fill these two values from the production GitHub OAuth App.
# Homepage: https://zello.asia
# Authorization callback: https://zello.asia/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
