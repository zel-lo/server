# Copy to .env in this directory. Spring Boot reads it as a properties file.
# Values are unquoted. The actual .env is ignored by Git.
GITHUB_LOGIN_ENABLED=true
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
# APP: GitHub App (no OAuth scopes); OAUTH: legacy OAuth App (read:user only).
GITHUB_APP_TYPE=APP
# GitHub App URL slug (https://github.com/apps/<slug>).
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_REDIRECT_URI=http://127.0.0.1:8080/login/oauth2/code/github
FRONTEND_BASE_URL=http://127.0.0.1:5173
DB_URL=jdbc:mysql://127.0.0.1:3306/zello?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=zello
DB_PASSWORD=your-local-mysql-password
# Set true when deployed behind HTTPS.
SESSION_COOKIE_SECURE=false
# Generate once: openssl rand -base64 32. Keep stable across backend restarts.
SESSION_ENCRYPTION_KEY=
